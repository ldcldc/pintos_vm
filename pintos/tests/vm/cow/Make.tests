# -*- makefile -*-

tests/vm/cow_TESTS = $(addprefix tests/vm/cow/cow-, simple mmap mmap-multi)

tests/vm/cow_PROGS = $(tests/vm/cow_TESTS)

tests/vm/cow/cow-simple_SRC = tests/vm/cow/cow-simple.c tests/lib.c tests/main.c
tests/vm/cow/cow-mmap_SRC = tests/vm/cow/cow-mmap.c tests/lib.c tests/main.c
tests/vm/cow/cow-mmap-multi_SRC = tests/vm/cow/cow-mmap-multi.c tests/lib.c tests/main.c

tests/vm/cow/cow-mmap_PUTFILES = tests/vm/sample.txt
